{
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "target": "ES2025",
    "lib": [
      "ES2025"
    ],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "node"
    ],
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
