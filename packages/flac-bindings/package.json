{
  "name": "flac-bindings",
  "version": "4.1.0",
  "libflac": "1.5.0",
  "libogg": "1.3.6",
  "description": "libflac bindings to node.js with easy to use API",
  "repository": "https://github.com/melchor629/node-flac-bindings/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./api": {
      "types": "./lib/api.d.ts",
      "import": "./lib/api.js"
    },
    "./decoder": {
      "types": "./lib/decoder/index.d.ts",
      "import": "./lib/decoder/index.js"
    },
    "./encoder": {
      "types": "./lib/encoder/index.d.ts",
      "import": "./lib/encoder/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "../../scripts/coverage.sh",
    "lint": "eslint ./src ./test ../../examples"
  },
  "keywords": [
    "flac",
    "encoder",
    "decoder",
    "binding"
  ],
  "author": "melchor9000",
  "license": "ISC",
  "dependencies": {
    "debug": "^4.3.4",
    "detect-libc": "^2.0.1",
    "tar-stream": "^3.0.0"
  },
  "peerDependencies": {
    "@melchor629/flac-bindings-lib": "4.1.0"
  },
  "peerDependenciesMeta": {
    "@melchor629/flac-bindings-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@melchor629/eslint-config": "^0.3.0",
    "@melchor629/flac-bindings-lib": "*",
    "@types/debug": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.0.0",
    "@types/temp": "^0.9.1",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/eslint-plugin": "^1.1.8",
    "cmake-js": "^8.0.0",
    "eslint": "^9.0.0",
    "jest-extended": "^7.0.0",
    "node-addon-api": "^8.0.0",
    "temp": "^0.9.4",
    "typescript": "^5.0.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.14.0",
    "electron": ">=35.0.0"
  },
  "binary": {
    "napi_versions": [
      10
    ]
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/melchor629"
  },
  "files": [
    "lib/*",
    "src/*",
    "scripts/flac-build.js",
    "CMakeLists.txt",
    "LICENSE",
    "readme.md"
  ]
}
