{
  "name": "flac-bindings",
  "version": "5.0.0",
  "description": "libflac bindings to node.js with easy to use API",
  "repository": {
    "type": "git",
    "directory": "packages/flac-bindings",
    "url": "git+https://github.com/melchor629/node-flac-bindings.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js"
    },
    "./api": {
      "types": "./src/api.d.ts",
      "import": "./src/api.js",
      "require": "./src/api.js"
    },
    "./decoder": {
      "types": "./src/decoder/index.d.ts",
      "import": "./src/decoder/index.js",
      "require": "./src/decoder/index.js"
    },
    "./encoder": {
      "types": "./src/encoder/index.d.ts",
      "import": "./src/encoder/index.js",
      "require": "./src/encoder/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "../../scripts/coverage.sh"
  },
  "keywords": [
    "flac",
    "encoder",
    "decoder",
    "binding"
  ],
  "author": "melchor9000",
  "license": "ISC",
  "dependencies": {
    "debug": "^4.3.4",
    "detect-libc": "^2.0.1"
  },
  "peerDependencies": {
    "@melchor629/flac-bindings-lib": "5.0.0"
  },
  "peerDependenciesMeta": {
    "@melchor629/flac-bindings-lib": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@melchor629/flac-bindings-lib-darwin-arm64": "5.0.0",
    "@melchor629/flac-bindings-lib-darwin-x64": "5.0.0",
    "@melchor629/flac-bindings-lib-linux-glibc-arm64": "5.0.0",
    "@melchor629/flac-bindings-lib-linux-glibc-x64": "5.0.0",
    "@melchor629/flac-bindings-lib-linux-musl-arm64": "5.0.0",
    "@melchor629/flac-bindings-lib-linux-musl-x64": "5.0.0",
    "@melchor629/flac-bindings-lib-win32-x64": "5.0.0",
    "@melchor629/flac-bindings-lib-win32-x86": "5.0.0"
  },
  "devDependencies": {
    "@melchor629/flac-bindings-lib": "*",
    "@types/node": "^24.0.0",
    "@types/temp": "^0.9.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jest-extended": "^7.0.0",
    "temp": "^0.9.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.14.0",
    "electron": ">=35.0.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/melchor629"
  },
  "files": [
    "src/*",
    "README.md"
  ]
}
